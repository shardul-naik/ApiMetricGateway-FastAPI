# Local backend configuration. Copy this file to .env and replace the values.
DATABASE_URL=mysql+pymysql://YOUR_MYSQL_USER:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/apimetric_db
DATABASE_SSL=false
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_REGISTER_KEY=replace-with-a-separate-admin-registration-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
